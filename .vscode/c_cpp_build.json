{
	"version": 1,
	"params": {
		"buildDir": "BUILD",
		"buildOutput": "${buildDir}/${buildTypeName}",
		"linkerScript": "STM32U5A5ZJTxQ_FLASH.ld",
		"cpu": "-mcpu=cortex-m33",
		"fpu": "-mfpu=fpv5-sp-d16 -mfloat-abi=hard",
		"extraSearchPaths": "-IDrivers/CMSIS/Device/ST/STM32U5xx/Include -IDrivers/CMSIS/Include",
		"dFile": "${buildOutput}/${fileDirectory}/${fileName}.d",
		"libs": [
			//"-Llvgl/libs/nema_gfx/lib/core/cortex_m33/gcc -l:libnemagfx-float-abi-hard.a",
			//"-LMiddlewares/ST/STM32_USBPD_Library/Core/lib -l:USBPDCORE_PD3_FULL_CM33_wc32.a",
			"-LMiddlewares/ST/STM32_USBPD_Library/Core/lib -l:USBPDCORE_PD3_CONFIG_MINSRC_CM33_wc32.a"
		]
	},
	"configurations": [
		{
			"name": "gcc",
			"problemMatchers": ["$gcc"],
			"buildTypes": [
				{
					"name": "debug",
					"params": { "buildTypeFlags": "-O0 -g" } // -O0 -g3
				},
				{
					"name": "release",
					"params": { "buildTypeFlags": "-O3 -g3" } // -O3 -g3 / -Os -g1
				}
			],
			"buildSteps": [
				{
					"name": "C Compile",
					"filePattern": "**/*.c",
					"outputFile": "${buildOutput}/${fileDirectory}/${fileName}.o",
					"trimIncludePaths": true,
					"params": {
						"flags": "${cpu} ${fpu} --specs=nano.specs -mthumb -ffunction-sections -fdata-sections -Wall -fstack-usage -Wno-packed-bitfield-compat -MMD -MP -MF[${dFile}] -MT[${outputFile}]"
					},
					"command": "arm-none-eabi-gcc -std=gnu2x -c ${flags} ${buildTypeFlags} (-I[$${includePath}]) (-D$${defines}) (-include [$${forcedInclude}]) [${filePath}] -o [${outputFile}] ${extraSearchPaths}"
				},
				{
					"name": "C++ Compile",
					"filePattern": "**/*.cpp",
					"outputFile": "${buildOutput}/${fileDirectory}/${fileName}.o",
					"trimIncludePaths": true,
					"params": {
						"flags": "${cpu} ${fpu} --specs=nano.specs -mthumb -ffunction-sections -fdata-sections -fno-rtti -fno-use-cxa-atexit -Wall -fstack-usage -Wno-packed-bitfield-compat -MMD -MP -MF[${dFile}] -MT[${outputFile}]"
					},
					"command": "arm-none-eabi-g++ -std=gnu++2b -c ${flags} ${buildTypeFlags} (-I[$${includePath}]) (-D$${defines}) (-include [$${forcedInclude}]) [${filePath}] -o [${outputFile}] ${extraSearchPaths}"
				},
				{
					"name": "Assembly Compile",
					"filePattern": "**/*.\\{s,S\\}",
					"outputFile": "${buildOutput}/${fileDirectory}/${fileName}.o",
					"trimIncludePaths": true,
					"params": {
						"flags": "${cpu} ${fpu} --specs=nano.specs -mthumb"
					},
					"command": "arm-none-eabi-gcc -c -x assembler-with-cpp ${flags} ${buildTypeFlags} (-D$${defines}) (-I[$${includePath}]) [${filePath}] -o [${outputFile}]"
				},
				{
					"name": "Build object list",
					"command": "shx find [${buildOutput}/**/*.o] > [${buildOutput}/objects.txt]"
				},
				{
					"name": "Link to elf",
					"params": {
						"flags": "-u _printf_float ${cpu} --specs=nosys.specs -Wl,-Map=[${buildOutput}/${workspaceRootFolderName}.map] -Wl,--gc-sections -static --specs=nano.specs ${fpu} -mthumb -Wl,--start-group -lc -lm -lstdc++ -lsupc++ -Wl,--end-group"
					},
					"command": "arm-none-eabi-g++ ${flags} -T[${linkerScript}] @[${buildOutput}/objects.txt] -o [${buildOutput}/${workspaceRootFolderName}.elf] $${libs}"
				},
				{
					"name": "elf -> list",
					"command": "arm-none-eabi-objdump -h -S [${buildOutput}/${workspaceRootFolderName}.elf] > [$${buildOutput}/${workspaceRootFolderName}.list]"
				},
				{
					"name": "elf -> bin",
					"command": "arm-none-eabi-objcopy -O binary [${buildOutput}/${workspaceRootFolderName}.elf] [$${buildOutput}/${workspaceRootFolderName}.bin]"
				},
				{
					"name": "elf -> hex",
					"command": "arm-none-eabi-objcopy -O ihex [${buildOutput}/${workspaceRootFolderName}.elf] [${buildOutput}/${workspaceRootFolderName}.hex]"
				},
				{
					"name": "size",
					"command": "arm-none-eabi-size [${buildOutput}/${workspaceRootFolderName}.elf]"
				}
				/*,
				{
					"name": "Deploy",
					"command": "st-flash write [${buildOutput}/${workspaceRootFolderName}.bin] 0x08000000"
				}
				*/
			]
		}
	]
}